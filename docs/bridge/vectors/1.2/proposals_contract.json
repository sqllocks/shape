{
  "api_version": "1.2",
  "cases": [
    {
      "name": "accepted-rules",
      "request": {
        "api_version": "1.2",
        "args": {
          "decisions": "${DIR}/rules.json",
          "output": "${DIR}/contract_rules.json"
        },
        "command": "proposals_contract",
        "id": "accepted-rules"
      },
      "response": {
        "api_version": "1.2",
        "command": "proposals_contract",
        "id": "accepted-rules",
        "ok": true,
        "result": {
          "rules": 3,
          "written": "${DIR}/contract_rules.json"
        },
        "warnings": []
      }
    },
    {
      "name": "merge",
      "request": {
        "api_version": "1.2",
        "args": {
          "decisions": "${DIR}/rules.json",
          "merge": "${DIR}/contract_base.json",
          "output": "${DIR}/contract_merged.json"
        },
        "command": "proposals_contract",
        "id": "merge"
      },
      "response": {
        "api_version": "1.2",
        "command": "proposals_contract",
        "id": "merge",
        "ok": true,
        "result": {
          "rules": 3,
          "written": "${DIR}/contract_merged.json"
        },
        "warnings": []
      }
    },
    {
      "name": "conflict",
      "request": {
        "api_version": "1.2",
        "args": {
          "decisions": "${DIR}/rules.json",
          "merge": "${DIR}/contract_conflicting.json",
          "output": "${DIR}/contract_conflict.json"
        },
        "command": "proposals_contract",
        "id": "conflict"
      },
      "response": {
        "api_version": "1.2",
        "command": "proposals_contract",
        "error": {
          "code": "input.contract_conflict",
          "group": "input",
          "hint": null,
