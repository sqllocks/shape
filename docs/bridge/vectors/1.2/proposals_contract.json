      },
      "command": "profile",
      "id": "setup"
    },
    {
      "api_version": "1.2",
      "args": {
        "data": [
          "${DIR}/shop"
        ],
        "decisions": "${DIR}/rules.json",
        "kinds": [
          "rule"
        ],
        "profile": "${DIR}/shop.shape"
      },
      "command": "proposals_propose",
      "id": "setup"
    },
    {
      "api_version": "1.2",
      "args": {
        "actor": "ana",
        "decisions": "${DIR}/rules.json",
        "proposal": "rule:customers.customer_id.unique",
        "verb": "accept"
      },
      "command": "proposals_decide",
      "id": "setup"
    },
    {
      "api_version": "1.2",
      "args": {
        "actor": "ana",
        "decisions": "${DIR}/rules.json",
        "proposal": "rule:orders.amount.dtype",
        "verb": "accept"
      },
      "command": "proposals_decide",
      "id": "setup"
    },
    {
      "api_version": "1.2",
      "args": {
        "actor": "ana",
        "decisions": "${DIR}/rules.json",
        "proposal": "rule:orders.row_count",
        "verb": "accept"
      },
      "command": "proposals_decide",
      "id": "setup"
    }
