        },
        "id": "conflict",
        "ok": false,
        "warnings": []
      }
    },
    {
      "name": "missing-output",
      "request": {
        "api_version": "1.2",
        "args": {
          "decisions": "${DIR}/rules.json"
        },
        "command": "proposals_contract",
        "id": "missing-output"
      },
      "response": {
        "api_version": "1.2",
        "command": "proposals_contract",
        "error": {
          "code": "usage.missing_argument",
          "group": "usage",
          "hint": null,
          "message": "proposals_contract needs the argument 'output'"
        },
        "id": "missing-output",
        "ok": false,
        "warnings": []
      },
      "valid_request": false
    }
  ],
  "command": "proposals_contract",
  "format": "shape-bridge-vectors",
  "setup": [
    {
      "api_version": "1.2",
      "args": {
        "dataset": true,
        "output": "${DIR}/shop.shape",
