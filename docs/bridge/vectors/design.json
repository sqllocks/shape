onth_name]                   NVARCHAR(255)        NOT NULL,\n    [week_of_year]                 BIGINT               NOT NULL,\n    [day_of_month]                 BIGINT               NOT NULL,\n    [day_of_week]                  BIGINT               NOT NULL,\n    [day_of_week_name]             NVARCHAR(255)        NOT NULL,\n    [is_weekend]                   BIT                  NOT NULL,\n    [is_weekday]                   BIT                  NOT NULL,\n    [fiscal_year]                  BIGINT               NOT NULL,\n    [fiscal_quarter]               BIGINT               NOT NULL,\n    CONSTRAINT [PK_dim_date] PRIMARY KEY ([sk_date])\n);\nGO\n\n-- junk: dim_sales_junk\nCREATE TABLE [dim_sales_junk] (\n    [sk_junk]                      BIGINT               NOT NULL,\n    [status]                       NVARCHAR(12)         NULL,\n    [priority]                     NVARCHAR(8)          NULL,\n    [is_gift]                      BIT                  NULL,\n    CONSTRAINT [PK_dim_sales_junk] PRIMARY KEY ([sk_junk])\n);\nGO\n\n-- bridge: bridge_sales_promotion\nCREATE TABLE [bridge_sales_promotion] (\n    [sk_promotion_group]           BIGINT               NOT NULL,\n    [sk_promotion]                 BIGINT               NOT NULL,\n    [weighting_factor]             DECIMAL(9,6)         NULL,\n    CONSTRAINT [PK_bridge_sales_promotion] PRIMARY KEY ([sk_promotion_group], [sk_promotion])\n);\nGO\n\n-- fact: fact_sales\nCREATE TABLE [fact_sales] (\n    [sk_customer]                  BIGINT               NOT NULL,\n    [sk_product]                   BIGINT               NOT NULL,\n    [sk_order_date]                BIGINT               NOT NULL,\n    [sk_ship_date]                 BIGINT               NOT NULL,\n    [sk_junk]                      BIGINT               NOT NULL,\n    [sk_promotion_group]           BIGINT               NOT NULL,\n    [order_id]                     BIGINT               NOT NULL,\n    [line_no]                      BIGINT               NOT NULL,\n    [quantity]                     BIGINT               NOT NULL,\n    [amount]                       DECIMAL(18,2)        NOT NULL,\n    [discount_pct]                 DECIMAL(5,2)         NULL,\n    CONSTRAINT [PK_fact_sales] PRIMARY KEY ([order_id], [line_no])\n);\nGO\n\n-- foreign keys\nALTER TABLE [bridge_sales_promotion] ADD CONSTRAINT [FK_bridge_sales_promotion_sk_promotion] FOREIGN KEY ([sk_promotion]) REFERENCES [dim_promotion] ([sk_promotion]);\nGO\nALTER TABLE [fact_sales] ADD CONSTRAINT [FK_fact_sales_sk_customer] FOREIGN KEY ([sk_customer]) REFERENCES [dim_customer] ([sk_customer]);\nGO\nALTER TABLE [fact_sales] ADD CONSTRAINT [FK_fact_sales_sk_product] FOREIGN KEY ([sk_product]) REFERENCES [dim_product] ([sk_product]);\nGO\nALTER TABLE [fact_sales] ADD CONSTRAINT [FK_fact_sales_sk_order_date] FOREIGN KEY ([sk_order_date]) REFERENCES [dim_date] ([sk_date]);\nGO\nALTER TABLE [fact_sales] ADD CONSTRAINT [FK_fact_sales_sk_ship_date] FOREIGN KEY ([sk_ship_date]) REFERENCES [dim_date] ([sk_date]);\nGO\nALTER TABLE [fact_sales] ADD CONSTRAINT [FK_fact_sales_sk_junk] FOREIGN KEY ([sk_junk]) REFERENCES [dim_sales_junk] ([sk_junk]);\nGO\n",
