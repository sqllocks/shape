{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "description": "the current .shape profile",
          "type": "string",
          "x-path": "read",
          "x-since": "1.0"
        },
        "before": {
          "description": "the baseline .shape profile",
          "type": "string",
          "x-path": "read",
          "x-since": "1.0"
        },
        "column_thresholds": {
          "description": "column name to {metric: threshold}",
          "type": "object",
          "x-since": "1.0"
        },
        "ignore_columns": {
          "description": "columns to leave out",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-since": "1.0"
        },
        "only_columns": {
          "description": "compare only these columns",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-since": "1.0"
        },
        "policy": {
          "description": "a named drift policy",
          "type": "string",
          "x-since": "1.0"
        },
        "project": {
          "description": "a shape.yml project file; its settings apply as for `--project FILE` (the bridge never looks for one on its own)",
          "type": "string",
          "x-path": "read",
          "x-since": "1.1"
        },
        "source": {
          "description": "the name of a source of `project`: its path, contract, baseline, thresholds, ignore lists and owners apply (needs project)",
          "type": "string",
          "x-since": "1.1"
        },
        "thresholds": {
          "description": "metric name to threshold, as for `shape diff --threshold`",
          "type": "object",
          "x-since": "1.0"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "command": {
      "const": "diff"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command",
    "args"
  ],
  "title": "diff request",
  "type": "object",
  "x-api-version": "1.2",
  "x-since": "1.0"
}
