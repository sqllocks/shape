{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "description": "the decision file (format shape-decisions)",
          "type": "string",
          "x-path": "read",
          "x-since": "1.2"
        },
        "merge": {
          "description": "an existing contract file to add the rules to (left unchanged); an accepted rule that disagrees with one there is `input.contract_conflict`",
          "type": "string",
          "x-path": "read",
          "x-since": "1.2"
        },
        "output": {
          "description": "the contract file to write (format contract v1)",
          "type": "string",
          "x-path": "write",
          "x-since": "1.2"
        }
      },
      "required": [
        "decisions",
        "output"
      ],
      "type": "object"
    },
    "command": {
      "const": "proposals_contract"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command",
    "args"
  ],
  "title": "proposals_contract request",
  "type": "object",
  "x-api-version": "1.2",
  "x-since": "1.2"
}
