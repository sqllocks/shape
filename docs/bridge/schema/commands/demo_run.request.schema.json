{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "connection": {
          "description": "a connection name or reference",
          "type": "string",
          "x-since": "1.0"
        },
        "domain": {
          "description": "the domain, where the scenario takes one",
          "type": "string",
          "x-since": "1.0"
        },
        "dry_run": {
          "description": "plan the demo without running it",
          "type": "boolean",
          "x-since": "1.0"
        },
        "input_file": {
          "description": "an input data file, where the scenario takes one",
          "type": "string",
          "x-path": "read",
          "x-since": "1.0"
        },
        "mode": {
          "description": "the demo mode (default: inference)",
          "type": "string",
          "x-since": "1.0"
        },
        "output_formats": {
          "description": "output formats to write",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-since": "1.0"
        },
        "rows": {
          "description": "rows to generate (default 50000)",
          "minimum": 1,
          "type": "integer",
          "x-since": "1.0"
        },
        "scale_mode": {
          "description": "auto, local_single, local_mp or fabric_spark",
          "type": "string",
          "x-since": "1.0"
        },
        "scenario": {
          "description": "the scenario name (default: retail)",
          "type": "string",
          "x-since": "1.0"
        },
        "seed": {
          "description": "the seed (default 42)",
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    },
    "command": {
      "const": "demo_run"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command"
  ],
  "title": "demo_run request",
  "type": "object",
  "x-api-version": "1.2",
  "x-since": "1.0"
}
