{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "output_dir": {
          "description": "write each scenario's tables under output_dir/<scenario>/ (default: write nothing)",
          "type": "string",
          "x-path": "write",
          "x-since": "1.2"
        },
        "scale": {
          "description": "a scale preset of the scenarios' domain, or tiny (default: small)",
          "type": "string",
          "x-since": "1.2"
        },
        "seed": {
          "description": "the seed (default: each scenario's own)",
          "type": "integer",
          "x-since": "1.2"
        },
        "suite": {
          "description": "a built-in suite name (see `suite_list`) or the path of a suite file (format shape-suite)",
          "type": "string",
          "x-name-or-path": true,
          "x-since": "1.2"
        }
      },
      "required": [
        "suite"
      ],
      "type": "object"
    },
    "command": {
      "const": "suite_run"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command",
    "args"
  ],
  "title": "suite_run request",
  "type": "object",
  "x-api-version": "1.2",
  "x-since": "1.2"
}
