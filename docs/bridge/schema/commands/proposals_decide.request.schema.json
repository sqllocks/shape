{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "description": "who decides (default: $SHAPE_ACTOR, else the login name)",
          "type": "string",
          "x-since": "1.1"
        },
        "decisions": {
          "description": "the decision file (format shape-decisions)",
          "type": "string",
          "x-path": "write",
          "x-since": "1.1"
        },
        "note": {
          "description": "why",
          "type": "string",
          "x-since": "1.1"
        },
        "proposal": {
          "description": "the proposal id, such as `pii:customers.email`",
          "type": "string",
          "x-since": "1.1"
        },
        "verb": {
          "description": "the decision",
          "enum": [
            "accept",
            "reject",
            "defer"
          ],
          "type": "string",
          "x-since": "1.1"
        }
      },
      "required": [
        "decisions",
        "proposal",
        "verb"
      ],
      "type": "object"
    },
    "command": {
      "const": "proposals_decide"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command",
    "args"
  ],
  "title": "proposals_decide request",
  "type": "object",
  "x-api-version": "1.2",
  "x-since": "1.1"
}
