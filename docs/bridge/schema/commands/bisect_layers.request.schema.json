{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "bad_date": {
          "description": "the date of the bad version (YYYY-MM-DD)",
          "type": "string",
          "x-since": "1.2"
        },
        "column": {
          "description": "the column, by the name the `map` values use",
          "type": "string",
          "x-since": "1.2"
        },
        "good_date": {
          "description": "the date of the good version (YYYY-MM-DD)",
          "type": "string",
          "x-since": "1.2"
        },
        "layers": {
          "description": "sources of the project file, in pipeline order",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-since": "1.2"
        },
        "map": {
          "description": "layer columns that are renamed: `{\"LAYER.COL\": \"COL\"}`",
          "type": "object",
          "x-since": "1.2"
        },
        "project": {
          "description": "the shape.yml file whose sources are the layers (the bridge never looks for one on its own, so give it)",
          "type": "string",
          "x-path": "read",
          "x-since": "1.2"
        }
      },
      "required": [
        "layers",
        "good_date",
        "bad_date"
      ],
      "type": "object"
    },
    "command": {
      "const": "bisect_layers"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command",
    "args"
  ],
  "title": "bisect_layers request",
  "type": "object",
  "x-api-version": "1.2",
  "x-since": "1.2"
}
