{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "compare": {
          "description": "an older contract file to run beside `contract`",
          "type": "string",
          "x-path": "read",
          "x-since": "1.2"
        },
        "contract": {
          "description": "the contract file (format contract v1)",
          "type": "string",
          "x-path": "read",
          "x-since": "1.2"
        },
        "incidents": {
          "description": "a file of known incidents (format shape-incidents)",
          "type": "string",
          "x-path": "read",
          "x-since": "1.2"
        },
        "name": {
          "description": "the registry name",
          "type": "string",
          "x-since": "1.2"
        },
        "registry": {
          "description": "the registry folder",
          "type": "string",
          "x-path": "read",
          "x-since": "1.2"
        },
        "since": {
          "description": "the first date, inclusive (YYYY-MM-DD)",
          "type": "string",
          "x-since": "1.2"
        },
        "until": {
          "description": "the last date, inclusive (YYYY-MM-DD)",
          "type": "string",
          "x-since": "1.2"
        },
        "window": {
          "description": "one entry per `day` (a version), or per ISO `week` or `month` (merged)",
          "enum": [
            "day",
            "week",
            "month"
          ],
          "type": "string",
          "x-since": "1.2"
        }
      },
      "required": [
        "registry",
        "name",
        "contract"
      ],
      "type": "object"
    },
    "command": {
      "const": "rules_backtest"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command",
    "args"
  ],
  "title": "rules_backtest request",
  "type": "object",
  "x-api-version": "1.2",
  "x-since": "1.2"
}
