{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "type": "object"
    },
    "command": {
      "enum": [
        "bisect",
        "bisect_layers",
        "chaos",
        "check",
        "contract_validate",
        "demo_cleanup",
        "demo_list",
        "demo_run",
        "demo_status",
        "describe",
        "design",
        "design_from_data",
        "diff",
        "dry_run",
        "format_schema",
        "generate",
        "job_cancel",
        "job_list",
        "job_status",
        "list",
        "preview",
        "profile",
        "profile_info",
        "profile_show",
        "project_show",
        "project_validate",
        "proposals_contract",
        "proposals_decide",
        "proposals_list",
        "proposals_propose",
        "registry_diff",
        "report_card",
        "report_card_read",
        "rules_backtest",
        "rules_mutate",
        "safe_scan",
        "scale_cancel",
        "scale_generate",
        "scale_status",
        "stream",
        "stream_status",
        "stream_stop",
        "timelapse",
        "validate",
        "verify"
      ]
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command"
  ],
  "title": "bridge request",
  "type": "object",
  "x-api-version": "1.2"
}
