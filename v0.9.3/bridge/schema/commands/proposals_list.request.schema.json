{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "description": "the decision file (format shape-decisions)",
          "type": "string",
          "x-path": "read",
          "x-since": "1.1"
        },
        "kind": {
          "description": "only proposals of this kind",
          "enum": [
            "relationship",
            "pii",
            "semantic",
            "rule",
            "type"
          ],
          "type": "string",
          "x-enum-since": {
            "rule": "1.2",
            "type": "1.2"
          },
          "x-since": "1.1"
        },
        "min_confidence": {
          "description": "only proposals at or above this",
          "maximum": 1,
          "minimum": 0,
          "type": "number",
          "x-since": "1.1"
        },
        "status": {
          "description": "only proposals in this state",
          "enum": [
            "pending",
            "accepted",
            "rejected",
            "deferred",
            "stale"
          ],
          "type": "string",
          "x-enum-since": {
            "stale": "1.2"
          },
          "x-since": "1.1"
        }
      },
      "required": [
        "decisions"
      ],
      "type": "object"
    },
    "command": {
      "const": "proposals_list"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean",
          "x-since": "1.0"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean",
          "x-since": "1.0"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer",
          "x-since": "1.0"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command",
    "args"
  ],
  "title": "proposals_list request",
  "type": "object",
  "x-api-version": "1.2",
  "x-since": "1.1"
}
