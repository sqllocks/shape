{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "additionalProperties": false,
      "properties": {
        "chunk_size": {
          "description": "rows per chunk (default 500000)",
          "minimum": 1,
          "type": "integer"
        },
        "domain": {
          "description": "an installed domain (see `list`) or a generation schema file",
          "type": "string"
        },
        "max_workers": {
          "description": "worker threads",
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "description": "the schema mode of a domain",
          "enum": [
            "3nf",
            "star"
          ],
          "type": "string"
        },
        "profile": {
          "description": "a distribution profile of the domain (default: `default`)",
          "type": "string"
        },
        "scale": {
          "description": "a scale preset (see `describe`)",
          "type": "string"
        },
        "scale_mode": {
          "description": "local_mp (default), local_single or fabric_spark",
          "enum": [
            "local_single",
            "local_mp",
            "fabric_spark"
          ],
          "type": "string"
        },
        "seed": {
          "description": "the seed (default: the schema's)",
          "type": "integer"
        },
        "sink_config": {
          "description": "settings per sink name, e.g. {\"parquet\": {\"output_dir\": ...}}; for fabric_spark workspace_id, lakehouse_id, notebook_name and token",
          "type": "object"
        },
        "sinks": {
          "description": "sinks to write to (default: memory)",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "domain"
      ],
      "type": "object"
    },
    "command": {
      "const": "scale_generate"
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command",
    "args"
  ],
  "title": "scale_generate request",
  "type": "object",
  "x-api-version": "1.0"
}
