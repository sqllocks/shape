{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
      "type": "string"
    },
    "args": {
      "type": "object"
    },
    "command": {
      "enum": [
        "check",
        "demo_cleanup",
        "demo_list",
        "demo_run",
        "demo_status",
        "describe",
        "diff",
        "dry_run",
        "generate",
        "job_cancel",
        "job_list",
        "job_status",
        "list",
        "preview",
        "profile",
        "profile_info",
        "scale_cancel",
        "scale_generate",
        "scale_status",
        "stream",
        "stream_status",
        "stream_stop",
        "validate",
        "verify"
      ]
    },
    "id": {
      "maxLength": 128,
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "async": {
          "default": false,
          "description": "for a command that can run as a job: return a job id at once and run in the background",
          "type": "boolean"
        },
        "include_raw_values": {
          "default": false,
          "description": "return raw values (minimum, maximum, category values, offending values) even for classified columns; off by default",
          "type": "boolean"
        },
        "max_inline_bytes": {
          "default": 262144,
          "description": "a result part larger than this is written to a file and returned as a reference",
          "minimum": 1024,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "command"
  ],
  "title": "bridge request",
  "type": "object",
  "x-api-version": "1.0"
}
