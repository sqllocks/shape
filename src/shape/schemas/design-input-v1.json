{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqllocks.github.io/shape/schemas/design-input-v1.json",
  "title": "Shape schema design input, version 1",
  "type": "object",
  "required": ["format", "version", "name", "entities"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "shape-design"},
    "version": {"const": 1},
    "name": {"type": "string"},
    "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "hierarchies": {"type": "array", "items": {"$ref": "#/$defs/hierarchy"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
  },
  "$defs": {
    "names": {"type": "array", "items": {"type": "string"}},
    "attribute": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "type": {
          "enum": ["integer", "string", "decimal", "timestamp", "boolean", "uuid", "float", "date", "time", "binary"]
        },
        "nullable": {"type": "boolean"},
        "max_length": {"type": "integer", "minimum": 1},
        "precision": {"type": "integer", "minimum": 1},
        "scale": {"type": "integer", "minimum": 0},
        "references": {"type": "string"}
      }
    },
    "dependency": {
      "type": "object",
      "required": ["determinant", "dependent"],
      "additionalProperties": false,
      "properties": {
        "determinant": {"$ref": "#/$defs/names"},
        "dependent": {"$ref": "#/$defs/names"}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {"enum": [0, 1, 2, 3]},
        "attributes": {"type": "object", "additionalProperties": {"enum": [0, 1, 2, 3]}}
      }
    },
    "entity": {
      "type": "object",
      "required": ["name", "attributes"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "attributes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attribute"}},
        "keys": {"type": "array", "items": {"$ref": "#/$defs/names"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "history": {"$ref": "#/$defs/history"}
      }
    },
    "hierarchy": {
      "type": "object",
      "required": ["name", "entity", "levels"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "entity": {"type": "string"},
        "levels": {"$ref": "#/$defs/names"}
      }
    },
    "measure": {
      "type": "object",
      "required": ["name", "attribute"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "attribute": {"type": "string"},
        "additivity": {"enum": ["additive", "semi_additive", "non_additive"]},
        "not_additive_over": {"$ref": "#/$defs/names"}
      }
    },
    "fact_dimension": {
      "type": "object",
      "required": ["entity", "via"],
      "additionalProperties": false,
      "properties": {
        "entity": {"type": "string"},
        "via": {"type": "string"},
        "role": {"type": "string"}
      }
    },
    "fact": {
      "type": "object",
      "required": ["name", "source"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "source": {"type": "string"},
        "grain": {"$ref": "#/$defs/names"},
        "measures": {"type": "array", "items": {"$ref": "#/$defs/measure"}},
        "dimensions": {"type": "array", "items": {"$ref": "#/$defs/fact_dimension"}},
        "dates": {"$ref": "#/$defs/names"},
        "degenerate": {"$ref": "#/$defs/names"},
        "junk": {"$ref": "#/$defs/names"},
        "many_to_many": {"$ref": "#/$defs/names"}
      }
    }
  }
}
