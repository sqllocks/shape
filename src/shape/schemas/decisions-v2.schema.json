{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sqllocks/shape/schemas/decisions-v2.schema.json",
  "title": "Shape decision file, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "proposals",
    "decisions"
  ],
  "properties": {
    "format": {
      "const": "shape-decisions"
    },
    "version": {
      "const": 2
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subject",
        "claim",
        "confidence",
        "evidence",
        "proposed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "enum": [
            "relationship",
            "pii",
            "semantic",
            "rule"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "object"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "object"
        },
        "proposed_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "status",
        "actor",
        "at",
        "note"
      ],
      "properties": {
        "proposal": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "deferred",
            "stale"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
