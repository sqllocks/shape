{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqllocks.github.io/shape/schemas/shape-canary-v1.schema.json",
  "title": "Shape canary document, version 1",
  "description": "A marked synthetic batch and its expected detections. The shape-canary payload of canary make --json also includes the output plan fields directory, files, rows and dry_run. The CLI shape-result envelope replaces format and version; validate its payload with this schema.",
  "type": "object",
  "required": ["format", "version", "id", "scenario", "seed", "marker", "expected"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "shape-canary"},
    "version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "\\S"},
    "scenario": {"type": "string", "pattern": "\\S"},
    "seed": {"type": "integer"},
    "marker": {
      "type": "object",
      "required": ["column", "value"],
      "additionalProperties": false,
      "properties": {
        "column": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "description": "Each item names one detection, or alternatives separated by |. Detection names are checked against the installed Shape catalog by the reader.",
      "items": {"type": "string", "pattern": "^(drift|gate|rule):[^|]+(\\|(drift|gate|rule):[^|]+)*$"}
    },
    "directory": {"type": "string"},
    "files": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "integer", "minimum": 1},
    "dry_run": {"type": "boolean"}
  },
  "dependentRequired": {
    "directory": ["files", "rows", "dry_run"],
    "files": ["directory", "rows", "dry_run"],
    "rows": ["directory", "files", "dry_run"],
    "dry_run": ["directory", "files", "rows"]
  }
}
