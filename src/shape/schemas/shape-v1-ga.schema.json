{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shape-as-code.org/schema/1.0/shape-v1.json",
  "title": "Shape as Code v1",
  "type": "object",
  "required": [
    "name",
    "version",
    "fidelity",
    "fields"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "fidelity": {
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ]
    },
    "mandatory_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "optional_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "semantic_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "sensitivity": {
            "type": "string"
          },
          "constraints": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Frozen Shape as Code 1.0 GA human-editable schema."
}
