{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sqllocks/shape/schemas/shape-backtest-report-v1.schema.json",
  "title": "Shape backtest report, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "window", "since", "until", "summary", "entries", "rules"],
  "properties": {
    "format": {"const": "shape-backtest-report"},
    "version": {"const": 1},
    "name": {"type": "string"},
    "window": {"enum": ["day", "week", "month"]},
    "since": {"type": ["string", "null"]},
    "until": {"type": ["string", "null"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "pass", "fail", "not_measured"],
      "properties": {
        "entries": {"type": "integer", "minimum": 0},
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "not_measured": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failed", "not_measured"],
        "properties": {
          "failed": {"type": "integer", "minimum": 0},
          "not_measured": {"type": "integer", "minimum": 0}
        }
      }
    },
    "incidents": {"type": "array", "items": {"$ref": "#/$defs/incident"}},
    "incident_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caught", "missed"],
      "properties": {
        "caught": {"type": "integer", "minimum": 0},
        "missed": {"type": "integer", "minimum": 0}
      }
    },
    "alarms_outside_incidents": {"type": "array", "items": {"type": "string"}},
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disagreements", "entries"],
      "properties": {
        "disagreements": {"type": "integer", "minimum": 0},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "old_status", "failed_rules", "old_failed_rules"],
            "properties": {
              "id": {"type": "string"},
              "status": {"enum": ["pass", "fail", "not_measured"]},
              "old_status": {"enum": ["pass", "fail", "not_measured"]},
              "failed_rules": {"type": "array", "items": {"type": "string"}},
              "old_failed_rules": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "window", "from", "to", "first_date", "last_date", "versions", "status", "rules", "failed_rules", "not_measured_rules"],
      "properties": {
        "id": {"type": "string"},
        "window": {"enum": ["day", "week", "month"]},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "first_date": {"type": "string"},
        "last_date": {"type": "string"},
        "versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["pass", "fail", "not_measured"]},
        "reason": {"type": "string"},
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed", "not_measured"],
          "properties": {
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "not_measured": {"type": "integer", "minimum": 0}
          }
        },
        "failed_rules": {"type": "array", "items": {"type": "string"}},
        "not_measured_rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "note", "status", "first_caught_by", "caught_by", "entries_inside"],
      "properties": {
        "id": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "note": {"type": "string"},
        "status": {"enum": ["caught", "missed"]},
        "first_caught_by": {"type": ["string", "null"]},
        "caught_by": {"type": "array", "items": {"type": "string"}},
        "entries_inside": {"type": "integer", "minimum": 0}
      }
    }
  }
}
