{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sqllocks/shape/schemas/reference-pack-v1.schema.json",
  "title": "Shape reference pack manifest (pack.json), format version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "name",
    "pack_version",
    "source",
    "retrieved",
    "license",
    "attribution",
    "transformation_version",
    "sensitivity",
    "datasets"
  ],
  "properties": {
    "format": {"const": "shape-reference-pack"},
    "version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "pack_version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "retrieved": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "attribution": {"type": "string", "minLength": 1},
    "transformation_version": {"type": "string", "minLength": 1},
    "sensitivity": {"type": "string", "minLength": 1},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "file", "fields", "rows", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"},
          "file": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,100}\\.arrow$"},
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "rows": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
