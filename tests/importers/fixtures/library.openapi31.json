{
  "openapi": "3.1.0",
  "info": {"title": "library", "version": "2"},
  "components": {
    "schemas": {
      "Author": {
        "type": "object",
        "required": ["author_id"],
        "properties": {
          "author_id": {"type": "string", "format": "uuid"},
          "born": {"type": ["string", "null"], "format": "date"}
        }
      },
      "Book": {
        "type": "object",
        "required": ["book_id", "author"],
        "properties": {
          "book_id": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "maxLength": 80},
          "author": {"$ref": "#/components/schemas/Author"},
          "editor": {"oneOf": [{"$ref": "#/components/schemas/Author"}, {"type": "null"}]},
          "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5}
        }
      }
    }
  }
}
