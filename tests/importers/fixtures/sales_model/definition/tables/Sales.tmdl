/// The fact table.
table Sales
	lineageTag: 11111111-1111-1111-1111-111111111111

	measure 'Total Amount' = SUM(Sales[Amount])
		formatString: #,0.00

	measure Margin =
			VAR cost = SUM(Sales[Cost])
			RETURN [Total Amount] - cost
		formatString: #,0.00

	column SaleId
		dataType: int64
		isKey
		sourceColumn: SaleId

	column CustomerKey
		dataType: int64
		isHidden
		sourceColumn: CustomerKey

	column Amount
		dataType: decimal
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: Amount

	column Cost
		dataType: double
		sourceColumn: Cost

	column OrderDate
		dataType: dateTime
		formatString: Short Date
		sourceColumn: OrderDate

	column ShipTime
		dataType: dateTime
		formatString: General Date
		sourceColumn: ShipTime

	column Paid
		dataType: boolean
		sourceColumn: Paid

	column Note
		dataType: string
		sourceColumn: Note

	column Receipt
		dataType: binary
		sourceColumn: Receipt

	column Weird
		dataType: variant

	column Untyped

	column 'Net Amount' = [Amount] - [Cost]
		dataType: decimal

	partition Sales = m
		mode: import
		source =
			let
			    Source = Sql.Database("server", "db")
			in
			    Source
