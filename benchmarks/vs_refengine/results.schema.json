{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "benchmarks/vs_refengine/results.json",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "runs",
    "generated_utc",
    "machine",
    "shape_commit",
    "shape_tree_dirty",
    "shape",
    "baseline"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mode": {
      "enum": [
        "quick",
        "full"
      ]
    },
    "runs": {
      "type": "integer",
      "minimum": 1
    },
    "generated_utc": {
      "type": "string"
    },
    "machine": {
      "type": "object"
    },
    "shape_commit": {
      "type": "string"
    },
    "shape_tree_dirty": {
      "type": "boolean"
    },
    "shape": {
      "$ref": "#/$defs/tool"
    },
    "kernel_microbench": {
      "$ref": "#/$defs/kernel_microbench"
    },
    "selection": {
      "type": "object",
      "required": [
        "only",
        "shard",
        "expected"
      ],
      "properties": {
        "only": {
          "enum": [
            "all",
            "profile",
            "generate",
            "stream"
          ]
        },
        "shard": {
          "type": [
            "string",
            "null"
          ]
        },
        "domains": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "datasets": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "baseline_domains": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nightly": {
      "type": "object"
    },
    "baseline": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "commit",
        "workloads"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "shape"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "workloads": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/workload"
          }
        }
      }
    }
  },
  "$defs": {
    "kernel_microbench": {
      "type": "object",
      "required": [
        "measured_utc",
        "machine",
        "rows",
        "runs",
        "kernels"
      ],
      "properties": {
        "measured_utc": {
          "type": "string"
        },
        "machine": {
          "type": "object"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "kernels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "rows",
              "native_s",
              "reference_s",
              "equivalent_to_reference"
            ],
            "properties": {
              "rows": {
                "type": "integer",
                "minimum": 1
              },
              "native_s": {
                "type": "number",
                "minimum": 0
              },
              "reference_s": {
                "type": "number",
                "minimum": 0
              },
              "baseline_s": {
                "type": "number",
                "minimum": 0
              },
              "equivalent_to_reference": {
                "const": true
              }
            }
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "workloads"
      ],
      "additionalProperties": false,
      "properties": {
        "workloads": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/workload"
          }
        }
      }
    },
    "verifier": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "status",
            "exit_code",
            "command"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "unavailable",
                "error",
                "not_comparable"
              ]
            },
            "exit_code": {
              "type": "integer"
            },
            "command": {
              "type": "string"
            },
            "first_run": {
              "type": "object"
            }
          }
        }
      ]
    },
    "workload": {
      "type": "object",
      "required": [
        "kind",
        "median_s",
        "runs_s",
        "verifier"
      ],
      "properties": {
        "kind": {
          "enum": [
            "profile",
            "generate",
            "stream"
          ]
        },
        "dataset": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "scale": {
          "type": "string"
        },
        "median_s": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "median_s_1t": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "runs_s": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "verifier": {
          "$ref": "#/$defs/verifier"
        },
        "ratio_vs_baseline": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "baseline_median_s": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "cli_ratio_vs_baseline": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        }
      }
    }
  }
}
