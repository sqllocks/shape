                      {
                        "type": "null"
                      }
                    ]
                  },
                  "decided_at": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected",
                      "deferred",
